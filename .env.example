# Copie para .env e preencha. O arquivo .env é ignorado pelo versionamento.

# ---------- Público: entra no bundle do aplicativo ----------
# Supabase Dashboard > Project Settings > API.
# Use a chave publishable (sb_publishable_...). Nunca service_role ou sb_secret_.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# ---------- Privado: apenas ferramentas locais (psql, migrations) ----------
# Sem o prefixo EXPO_PUBLIC_, portanto fora do bundle.
# Supabase Dashboard > Connect > Session pooler.
SUPABASE_PROJECT_REF=seu-project-ref
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# Transaction pooler (6543): conexões curtas da aplicação.
SUPABASE_DB_URL_TRANSACTION=postgresql://postgres.PROJECT_REF:SENHA@HOST.pooler.supabase.com:6543/postgres

# Session pooler (5432): usado por `npm run migrate`.
SUPABASE_DB_URL_SESSION=postgresql://postgres.PROJECT_REF:SENHA@HOST.pooler.supabase.com:5432/postgres
